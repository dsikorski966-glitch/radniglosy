{
  "name": "glosowanie-dsm",
  "version": "2.0.0",
  "description": "System glosowania DSM - Next.js + Postgres (bez Supabase). Terminal Dell + CasaOS + Cloudflare Tunnel.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node scripts/migrate.js",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v",
    "dev:setup": "node --env-file=.env.local scripts/migrate.js",
    "dev:reset": "node -e \"require('fs').rmSync('./data/dsm-dev',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "next": "14.2.0",
    "pg": "8.11.3",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "autoprefixer": "10.4.16",
    "postcss": "8.4.33",
    "tailwindcss": "3.4.1"
  }
}
